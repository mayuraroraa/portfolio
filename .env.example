# ==============================================================================
# SECURE ENVIRONMENT VARIABLES CONFIGURATION (.env.example)
# Copy this file to .env.local and populate with your private credentials.
# NEVER commit .env.local or secret values to version control.
# ==============================================================================

# MongoDB Atlas Connection
# Format: mongodb+srv://<username>:<password>@<cluster-address>/?retryWrites=true&w=majority
MONGODB_URI=YOUR_MONGODB_ATLAS_CONNECTION_STRING
MONGODB_DB=YOUR_DATABASE_NAME

# Server-Side Authentication & Session Security (Cryptographic Secret, Min 32 chars)
JWT_SECRET=YOUR_SECURE_JWT_SECRET_KEY_MINIMUM_32_CHARACTERS

# Public Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional External Media Provider (e.g., Cloudinary Storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
